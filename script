-- AUTO FARM
----------------------------------------------------

local folder1 = workspace:FindFirstChild("Entities")
local folder2 = workspace:FindFirstChild("Entities2")

local function SetNoClip(character, enabled)
	for _, obj in ipairs(character:GetDescendants()) do
		if obj:IsA("BasePart") then
			obj.CanCollide = not enabled
		end
	end
end

local function FreezeCharacter(character, freeze)
	local humanoid = character:FindFirstChildOfClass("Humanoid")
	local hrp = character:FindFirstChild("HumanoidRootPart")

	if humanoid then
		if freeze then
			humanoid.WalkSpeed = 0
			humanoid.JumpPower = 0
			humanoid.AutoRotate = false
			humanoid.PlatformStand = true
		else
			humanoid.WalkSpeed = 16
			humanoid.JumpPower = 50
			humanoid.AutoRotate = true
			humanoid.PlatformStand = false
		end
	end

	if hrp then
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
	end
end

local function AttackTarget(target)
	local hrp = target:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end

	local plrhrp = char and char:FindFirstChild("HumanoidRootPart")
	if not plrhrp then
		return
	end

	plrhrp.AssemblyLinearVelocity = Vector3.zero
	plrhrp.AssemblyAngularVelocity = Vector3.zero

	local angle = tick() * 3
	local offset = Vector3.new(
		math.cos(angle),
		-7,
		math.sin(angle)
	)

	plrhrp.CFrame = CFrame.new(
		hrp.Position + offset,
		hrp.Position
	)

	local tool = char:FindFirstChildOfClass("Tool")
	if tool then
		tool:Activate()
	end
end

local function GetTargets(isBoss)
	local targets = {}

	for _, folder in ipairs({folder1, folder2}) do
		if folder then
			for _, entity in ipairs(folder:GetChildren()) do
				local boss = entity:FindFirstChild("BossEntity") ~= nil

				if boss == isBoss then
					table.insert(targets, entity)
				end
			end
		end
	end

	return targets
end

local function AutoFarm()
	if bossfrm or mobfrm then
		if char then
			SetNoClip(char, true)
			FreezeCharacter(char, true)
		end

		local targets = GetTargets(bossfrm)

		for _, target in ipairs(targets) do
			AttackTarget(target)
		end
	else
		if char then
			SetNoClip(char, false)
			FreezeCharacter(char, false)
		end
	end
end

----------------------------------------------------
-- MAIN LOOP (FLY FIX FINAL)
----------------------------------------------------

local function load()
	if closed == false then
		
		if not minimized then
			local categories = {
				category0,
				category1,
				category2
			}

			for i, category in ipairs(categories) do
				category.Visible = (i - 1) == selectedcategory
			end
		end
		AutoFarm()
		applyStats()

		if fly and gyro and vel and root then

			local cam = camera.CFrame

			local dir = Vector3.zero
			if UIS:IsKeyDown(Enum.KeyCode.W) then dir += cam.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.S) then dir -= cam.LookVector end
			if UIS:IsKeyDown(Enum.KeyCode.A) then dir -= cam.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.D) then dir += cam.RightVector end
			if UIS:IsKeyDown(Enum.KeyCode.Space) then dir += Vector3.new(0,1,0) end
			if UIS:IsKeyDown(Enum.KeyCode.LeftShift) then dir -= Vector3.new(0,1,0) end

			local target = dir * (speed * flySpeed)
			smoothVel = smoothVel:Lerp(target, 0.18)

			vel.VectorVelocity = smoothVel

			-- 🔥 FULL FIX 3D ORIENTATION
			gyro.CFrame = camera.CFrame
		end
	end
end
load()

while wait(.1) do 
	load()
	if closed then
		wait(.2)
		break
	end
end

