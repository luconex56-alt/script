----------------------------------------------------
-- DRAG
----------------------------------------------------

local dragging = false
local dragStart, startPos

top.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = true
		dragStart = input.Position
		startPos = main.Position
	end
end)

UIS.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		dragging = false
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
		local delta = input.Position - dragStart
		main.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	end
end)

----------------------------------------------------
-- BUTTON FACTORY
----------------------------------------------------

local function button(text,y,x,w)
	local b = Instance.new("TextButton")
	b.Size = UDim2.new(0,w or 120,0,28)
	b.Position = UDim2.new(0,x or 10,0,y)
	b.BackgroundColor3 = Color3.fromRGB(40,40,50)
	b.TextColor3 = Color3.new(1,1,1)
	b.Font = Enum.Font.Gotham
	b.TextSize = 13
	b.Text = text
	b.Parent = main

	Instance.new("UICorner", b).CornerRadius = UDim.new(0,8)

	b.MouseButton1Click:Connect(function()
		TweenService:Create(b,TweenInfo.new(0.1),{Size=UDim2.new(0,w or 120,0,26)}):Play()
		task.wait(0.1)
		TweenService:Create(b,TweenInfo.new(0.1),{Size=UDim2.new(0,w or 120,0,28)}):Play()
	end)

	return b
end

local function box(ph,y,x,w)
	local t = Instance.new("TextBox")
	t.Size = UDim2.new(0,w or 120,0,28)
	t.Position = UDim2.new(0,x or 10,0,y)
	t.BackgroundColor3 = Color3.fromRGB(25,25,32)
	t.TextColor3 = Color3.new(1,1,1)
	t.Font = Enum.Font.Gotham
	t.TextSize = 12
	t.ClearTextOnFocus = false
	t.Text = ""
	t.PlaceholderText = ph
	t.Parent = main

	Instance.new("UICorner", t).CornerRadius = UDim.new(0,8)

	return t
end

