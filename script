--// OneOneX Hub V6 | CLEAN FIX (FLY + UI + RESET ORIGINAL STATE)

local Players = game:GetService("Players")
local UIS = game:GetService("UserInputService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Lighting = game:GetService("Lighting")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

----------------------------------------------------
-- CHARACTER + SAVE ORIGINAL STATS (IMPORTANT FIX)
----------------------------------------------------

local char = player.Character or player.CharacterAdded:Wait()
local hum = char:WaitForChild("Humanoid")
local root = char:WaitForChild("HumanoidRootPart")

local originalSpeed = hum.WalkSpeed
local originalJump = hum.JumpPower

player.CharacterAdded:Connect(function(c)
	char = c
	hum = c:WaitForChild("Humanoid")
	root = c:WaitForChild("HumanoidRootPart")

	originalSpeed = hum.WalkSpeed
	originalJump = hum.JumpPower
end)

----------------------------------------------------
-- STATE
----------------------------------------------------

local fly = false
local noclip = false
local infJump = false
local running = true

local speed = 60 -- ⚡ faster base (fix demandé)
local jump = 70
local flySpeed = 1

local gyro, vel, force, att
local smoothVel = Vector3.zero

----------------------------------------------------
-- RESET (RESTORE PLAYER ORIGINAL STATE)
----------------------------------------------------

function resetAll()
	fly = false
	noclip = false
	infJump = false

	if hum then
		hum.WalkSpeed = originalSpeed
		hum.JumpPower = originalJump
	end

	if flyBtn then flyBtn.Text = "Fly: OFF" end
	if noclipBtn then noclipBtn.Text = "Noclip: OFF" end
	if infJumpBtn then infJumpBtn.Text = "Infinite Jump: OFF" end

	if gyro then gyro:Destroy() gyro = nil end
	if vel then vel:Destroy() vel = nil end
	if force then force:Destroy() force = nil end
	if att then att:Destroy() att = nil end

	smoothVel = Vector3.zero
end

----------------------------------------------------
-- APPLY STATS
----------------------------------------------------

local function applyStats()
	if hum then
		hum.UseJumpPower = true
		hum.WalkSpeed = speed
		hum.JumpPower = jump
	end
end

----------------------------------------------------
-- FLY SYSTEM (FIX GRAVITY + ORIENTATION)
----------------------------------------------------
local function startFly()

	if not char or not hum or not root then return end

	hum.AutoRotate = false
	hum:ChangeState(Enum.HumanoidStateType.Physics)

	att = Instance.new("Attachment")
	att.Parent = root

	gyro = Instance.new("AlignOrientation")
	gyro.Attachment0 = att
	gyro.Mode = Enum.OrientationAlignmentMode.OneAttachment
	gyro.MaxTorque = math.huge
	gyro.Responsiveness = 25
	gyro.Parent = root

	vel = Instance.new("LinearVelocity")
	vel.Attachment0 = att
	vel.RelativeTo = Enum.ActuatorRelativeTo.World
	vel.MaxForce = math.huge
	vel.Parent = root

	force = Instance.new("VectorForce")
	force.Attachment0 = att
	force.Force = Vector3.new(0, workspace.Gravity * root.AssemblyMass, 0)
	force.RelativeTo = Enum.ActuatorRelativeTo.World
	force.Parent = root
end

local function stopFly()

	if hum then
		hum.AutoRotate = true
		hum:ChangeState(Enum.HumanoidStateType.GettingUp)
	end

	if gyro then gyro:Destroy() gyro = nil end
	if vel then vel:Destroy() vel = nil end
	if force then force:Destroy() force = nil end
	if att then att:Destroy() att = nil end

	smoothVel = Vector3.zero
end

